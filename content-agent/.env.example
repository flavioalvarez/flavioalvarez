# ---------------------------------------------------------------------------
# Okeybot - Agente de contenido vertical (IG / TikTok / YouTube Shorts)
# Copiá este archivo a `.env` y completá las credenciales que vayas a usar.
# Cualquier fuente sin credenciales se omite automaticamente (no rompe el flujo).
# ---------------------------------------------------------------------------

# --- LLM de ideacion (Anthropic / Claude) ---
ANTHROPIC_API_KEY=
# Modelo para ideacion/guiones. Por defecto: claude-sonnet-4-6
IDEATION_MODEL=claude-sonnet-4-6

# --- Higgsfield (generacion de imagen + video) ---
# Auth tipo key + secret de la API oficial (platform.higgsfield.ai).
HIGGSFIELD_API_KEY=
HIGGSFIELD_SECRET=
HIGGSFIELD_BASE_URL=https://platform.higgsfield.ai
# IDs de modelo. Confirmalos en tu dashboard de Higgsfield; estos son los defaults.
HIGGSFIELD_IMAGE_MODEL=nano-banana-pro
HIGGSFIELD_VIDEO_MODEL=seedance2

# --- Reddit (OAuth script app) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=okeybot-content-agent/1.0

# --- YouTube Data API v3 ---
YOUTUBE_API_KEY=

# --- Twitter / X API v2 (opcional, caro) ---
TWITTER_BEARER_TOKEN=

# --- Publicacion (borradores con aprobacion obligatoria) ---
# Adaptadores: buffer | ayrshare | local   (default: local)
PUBLISHER=local
# Buffer
BUFFER_ACCESS_TOKEN=
BUFFER_PROFILE_IDS=         # separados por coma
# Ayrshare
AYRSHARE_API_KEY=

# --- Comportamiento ---
PIECES_PER_RUN=2
OUTPUT_DIR=output
# Poner DRY_RUN=true para correr el flujo completo con datos simulados (sin gastar credito).
DRY_RUN=false
